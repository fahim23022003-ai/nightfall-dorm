extends "res://tests/replay_endless.gd"
func run():
 var a=fixture();var m=a.m;var r=m.player();var signature=Support.model_signature(m)
 check(m.place_building("turret",r.fixed_tile_position(0)),"real paid weapon")
 m.hunter.target=0;m.hunter.state=HunterState.State.ATTACK;m.hunter.position=r.door_approach()
 var wallet=[r.gold,r.electricity,r.door_hp,m.hunter.hp,m.random.state,m.shots]
 WaveOpportunities.observe(m,.5)
 check([r.gold,r.electricity,r.door_hp,m.hunter.hp,m.random.state,m.shots]==wallet,"opportunity observation cannot change economy/combat/RNG")
 check(WaveOpportunities.valid(m.wave_metrics.data.observations),"bounded valid observation ledger")
 m.wrath.rules_remaining=2;WaveOpportunities.observe(m,.5)
 check(m.wave_metrics.data.observations["16"].disabled==.5,"actual disable counted")
 m.wrath.rules_remaining=0;m.hunter.position=r.tile_position(16)+Vector2(500,0);WaveOpportunities.observe(m,2)
 check(m.wave_metrics.data.observations["16"].door_out==2,"actual out-of-range door siege distinguished")
 var d=m.wave_metrics.report();check(WaveOpportunities.insights(d).size()<=3 and "siege" in WaveOpportunities.insights(d)[0],"bounded factual advice")
 check(WaveOpportunities.insights({"available":false})==["Historical observations unavailable. No cause inferred."],"legacy reason never guessed")
 var bad=m.wave_metrics.data.observations.duplicate(true);bad["16"].seen=-1;check(not WaveOpportunities.valid(bad),"invalid observed duration rejected")
 var q=UpgradeNotices.new()
 for i in range(144):q.push("Needle L10")
 check(q.queue.size()==1 and q.queue[0].count==144,"burst feedback coalesces with exact count")
 q.update(10,true);check(q.active.is_empty() and q.queue.size()==1,"urgent warnings defer notice lane without losing actions")
 q.update(.1,false);check("144" in q.text(),"deferred feedback readable")
 for i in range(50):q.clock+=1;q.push("Upgrade %d" % i)
 check(q.queue.size()<=6,"notification accumulation bounded")
 var profile=PlayerProfile.new(prefix+"guidance.json")
 check(profile.settings.guidance_mode=="show" and profile.update_setting("guidance_mode","minimal"),"saved guidance preference")
 var reload=PlayerProfile.new(profile.path);check(reload.load_profile() and reload.settings.guidance_mode=="minimal","guidance disk roundtrip")
 check(not profile.update_setting("guidance_mode","unknown"),"invalid preference rejected")
 clear_wave(a);var saved=Snapshot.encode(m)
 check(Snapshot.restore(JSON.parse_string(JSON.stringify(saved)))!=null,"opportunity observations survive real checkpoint JSON")
 saved.wave_metrics.erase("observations");check(Snapshot.restore(saved)!=null,"Phase10 telemetry without opportunity data preserved")
 print("FIRST_NIGHT_FEATURE_CHECKS=",checks," FAILURES=",failures);Support.cleanup(prefix);quit(1 if failures else 0)
